# Render supplies PORT automatically. This value is for local development.
PORT=3001
# When the Turso variables below are not set, Forge uses this local SQLite file.
DATABASE_PATH=./data/forge.db
# For hosted deployments, set both values from your Turso database dashboard.
# Never commit a real auth token.
# TURSO_DATABASE_URL=libsql://your-database-your-account.turso.io
# TURSO_AUTH_TOKEN=replace-with-your-turso-token
SESSION_DAYS=30
# Set to 1 only when served over HTTPS.
COOKIE_SECURE=0
# When deployed behind one trusted reverse proxy, set this to 1 so login
# rate-limiting sees the real client IP. Leave unset for direct/local access.
# TRUST_PROXY=1
